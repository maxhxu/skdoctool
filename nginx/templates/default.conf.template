# Reverse proxy + static frontend host in front of the FastAPI app.
#
# Terminates TLS, serves the built React SPA, and proxies /api to the app
# container on the same origin, so cookies stay same-site with no CORS.
#
# This is a *.template file: the nginx image's entrypoint runs it through
# envsubst on container start, substituting ${DOMAIN} from the environment
# (see docker-compose.yml) before writing it to /etc/nginx/conf.d/default.conf.
# Nginx's own runtime variables ($host, $scheme, etc.) aren't shell env vars,
# so envsubst leaves them alone.
#
# Certs come from the certbot service (see init-letsencrypt.sh + the
# `certbot` service in docker-compose.yml), landing at the conventional
# /etc/letsencrypt/live/$DOMAIN/ path.

# Clickjacking policy, by route. Only a *file* page may be framed — that's the
# embed feature (README "Embedding a file on another site"): third-party sites
# put <iframe src="https://${DOMAIN}/files/3"> on their own pages. Every other
# route — the file list, /files/new, login, profiles — has no reason to be
# framed and is denied below.
#
# The exception inside the exception: `?embed=0` tells the SPA to render the
# *full* app inside the frame, edit controls and all. That's an escape hatch,
# not an embed, so it gets the same denial as everything else. Empty value =
# nginx omits the header entirely, i.e. framing allowed.
map $arg_embed $file_page_xfo {
    default  "";
    "0"      "DENY";
    "false"  "DENY";
}

map $arg_embed $file_page_csp {
    default  "";
    "0"      "frame-ancestors 'none'";
    "false"  "frame-ancestors 'none'";
}

server {
    listen 80;
    server_name ${DOMAIN};

    # ACME HTTP-01 challenge path — certbot writes here, this must stay
    # reachable over plain HTTP even after the redirect below exists.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location /api/ {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    root /usr/share/nginx/html;
    index index.html;

    # The one framable route: a single file's page, which is what an embed
    # points at. `try_files /index.html =404` serves the SPA shell *without* an
    # internal redirect — falling through to `location /` instead would hand the
    # response that block's deny headers and break every embed.
    location ~ ^/files/[0-9]+/?$ {
        add_header X-Frame-Options $file_page_xfo always;
        add_header Content-Security-Policy $file_page_csp always;
        try_files /index.html =404;
    }

    location / {
        # Not framable: /files, /files/new, /login, /u/*, and the static assets.
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;

        # react-router client-side routing: fall back to index.html
        try_files $uri /index.html;
    }
}
